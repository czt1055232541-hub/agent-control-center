# Runtime
NODE_ENV=development
LOG_LEVEL=info
DRY_RUN=true

# lark-cli
# Keep these paths explicit on Windows so lark-cli does not inherit OpenClaw's
# HOME/OPENCLAW_HOME context when this agent is started by a service wrapper.
HOME=C:\path\to\agent-control-center\agent-runtime\.home
LARK_CLI_HOME=C:\path\to\agent-control-center\agent-runtime\.home\.lark-cli
LARK_CLI_CWD=C:\path\to\agent-control-center
LARK_CLI_BIN=
LARK_IDENTITY=bot
LARK_CLI_OUTPUT_ENCODING=utf-8
LARK_READY_MARKER=ready|listening|connected|waiting|consume|event|\u542f\u52a8|\u76d1\u542c|\u7b49\u5f85
LARK_BOT_NAME=代码执行官
LARK_BOT_OPEN_ID=ou_placeholder
LARK_BOT_USER_ID=
LARK_BOT_UNION_ID=

# Agent provider: local | openai | codex
AGENT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_CLI_BIN=E:\codeX\bin\codex.exe
CODEX_AGENT_ARGS=exec --skip-git-repo-check

# A2A Multi-Agent Configuration
A2A_BOTS=[{"name":"项目调度官","openId":"ou_placeholder","description":"coordinator"},{"name":"代码执行官","openId":"ou_placeholder","description":"developer"},{"name":"运维验证官","openId":"ou_placeholder","description":"ops-validation"},{"name":"质量审计官","openId":"ou_placeholder","description":"quality-auditor"},{"name":"项目档案官","openId":"ou_placeholder","description":"archivist"}]
A2A_RELAY_ENABLED=false
A2A_RELAY_GROUP_CHAT_ID=oc_placeholder
A2A_RELAY_PEER_NAME=质量审计官
A2A_RELAY_PEER_CLI_HOME=C:\Users\admin

# Safety
CONFIRM_TIMEOUT_MS=600000
MAX_CONTEXT_MESSAGES=30
