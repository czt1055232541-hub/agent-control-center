# Runtime
NODE_ENV=development
LOG_LEVEL=info
DRY_RUN=true

# lark-cli
# Leave empty to auto-detect ../.npm-global/.../lark-cli.exe on Windows.
LARK_CLI_BIN=
LARK_IDENTITY=bot
LARK_CLI_OUTPUT_ENCODING=auto
LARK_READY_MARKER=ready|listening|connected|waiting|consume|event|\u542f\u52a8|\u76d1\u542c|\u7b49\u5f85
LARK_BOT_NAME=Codex
LARK_BOT_OPEN_ID=
LARK_BOT_USER_ID=
LARK_BOT_UNION_ID=

# Agent provider: local | openai | codex
AGENT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_CLI_BIN=codex
CODEX_AGENT_ARGS=exec --skip-git-repo-check

# Safety
CONFIRM_TIMEOUT_MS=600000
MAX_CONTEXT_MESSAGES=30
